# IP-SAKTI environment configuration (example).
# Copy to `.env` and fill in real values. NEVER commit `.env` (see .gitignore).
# All settings are read by ipsakti.core.config.Settings via pydantic-settings.

# --- Application ---
IPSAKTI_ENV=development
IPSAKTI_LOG_LEVEL=INFO
IPSAKTI_SECRET_KEY=change-me-in-production-use-a-long-random-value
IPSAKTI_API_V1_PREFIX=/api/v1

# --- Security / tokens ---
IPSAKTI_ACCESS_TOKEN_TTL_MINUTES=15
IPSAKTI_REFRESH_TOKEN_TTL_DAYS=7
IPSAKTI_JWT_ALGORITHM=HS256

# --- PostgreSQL (system of record) ---
IPSAKTI_DATABASE_URL=postgresql+psycopg://ipsakti:ipsakti@localhost:5432/ipsakti

# --- Qdrant (derived vector index) ---
IPSAKTI_QDRANT_URL=http://localhost:6333
IPSAKTI_QDRANT_COLLECTION=ipsakti_chunks

# --- Embeddings / reranking ---
IPSAKTI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IPSAKTI_EMBEDDING_DIM=384
IPSAKTI_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval tunables ---
IPSAKTI_RRF_K=60
IPSAKTI_CANDIDATE_POOL_SIZE=30
IPSAKTI_FINAL_RESULT_SIZE=8
IPSAKTI_RELEVANCE_THRESHOLD=0.3

# --- Chunking tunables ---
IPSAKTI_CHUNK_TARGET_TOKENS=600
IPSAKTI_CHUNK_OVERLAP_TOKENS=75

# --- Generation (Groq) ---
IPSAKTI_GROQ_API_KEY=
IPSAKTI_GROQ_MODEL=llama-3.1-70b-versatile

# --- Storage ---
IPSAKTI_STORAGE_ROOT=data/storage
IPSAKTI_MAX_UPLOAD_BYTES=52428800
